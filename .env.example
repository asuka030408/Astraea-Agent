# Copy this file to .env and fill in your own values.
ASTRAEA_API_KEY=your-api-key
ASTRAEA_BASE_URL=https://api.deepseek.com
ASTRAEA_MODEL=deepseek-chat
# Optional: a separate model for T4 summaries (defaults to ASTRAEA_MODEL).
# ASTRAEA_COMPACTOR_MODEL=deepseek-chat
# Set this to your model's actual context-window size.
ASTRAEA_CONTEXT_WINDOW=64000
# Optional: Bailian embedding service for post-turn Memory indexing.
# ASTRAEA_EMBEDDING_API_KEY=your-bailian-key
# ASTRAEA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASTRAEA_EMBEDDING_MODEL=text-embedding-v4
# ASTRAEA_EMBEDDING_DIMENSIONS=1024
# Optional: directory the four coding tools may access.
# ASTRAEA_WORKSPACE=E:\your-project
